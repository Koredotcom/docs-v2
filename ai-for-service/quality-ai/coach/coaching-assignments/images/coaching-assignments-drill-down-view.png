tions-footer .avatar-actions .avatar-bg{width:72px;height:72px}.kore-chat-window-main-section.no-avatar-bg-icon{height:calc(100% - 80px)}@media(max-width: 600px){.kore-chat-window-main-section{width:calc(100% - 20px);height:calc(100% - 115px);right:10px;bottom:40px;max-width:100%}}@media(max-height: 300px){.kore-chat-window-main-section{height:100%;bottom:0px}}.kore-chat-window-main-section.minimize-chat{height:0px;width:0px;top:auto}.kore-chat-window-main-section.minimize-chat .welcome-chat-section{transform:scale(0)}.kore-chat-window-main-section.minimize-chat .kr-wiz-menu-chat{display:none !important}.kore-chat-window-main-section.minimize-chat .kr-wiz-menu-chat.show{display:none !important}.kore-chat-window-main-section .kr-wiz-menu-chat{display:none;float:left;transition:ease-in .33s}.kore-chat-window-main-section .kr-wiz-menu-chat.show{display:block}.kore-chat-window-main-section .kore-sdk-error-section{display:block;text-align:center;background:#fef3f2;color:#b42318;font-size:var(--font-size-text-xs, 12px);font-weight:var(--font-weight-normal-Medium, 500);line-height:var(--font-line-height-text-xs, 16px);padding:8px}.kore-chat-window-main-section .kore-sdk-error-section.hide{display:none}</style><style>.chat-widgetwrapper-main-container{height:100%;box-shadow:var(--chat-widget-box-shadow);border-radius:4px;display:flex;flex-direction:column;transition:transform 1s;transform-origin:100% 100%;display:none}.chat-widgetwrapper-main-container.testFlow{display:flex;background-color:#fff}.chat-widgetwrapper-main-container.minimize{animation:bounce-in .5s ease forwards;display:flex}.chat-widgetwrapper-main-container.minimizeQuick{transform-origin:bottom right;animation:quick .3s ease forwards;display:flex}.chat-widgetwrapper-main-container.minimizeSmooth{transform-origin:bottom right;animation:quick 1s ease forwards;display:flex}</style><style>.chat-widget-header{background:var(--chat-widget-header-bg);border-bottom:1px solid var(--chat-widget-header-border);border-radius:4px 4px 0px 0px;display:flex;align-items:center;width:100%;padding:16px;position:relative;gap:8px}.chat-widget-header.transparent-style{background:hsla(0,0%,100%,.7);backdrop-filter:blur(10px)}.chat-widget-header.regular{align-items:flex-start}.chat-widget-header.regular .info-content-data{display:block;text-align:center}.chat-widget-header.regular .info-content-data .bot_icon{margin:0 auto 5px auto}.chat-widget-header.regular .info-content-data .img-block{justify-content:center;margin:0 0 12px 0}.chat-widget-header.regular .info-content-data .content-text h1{text-align:center}.chat-widget-header.regular .info-content-data .content-text h2{text-align:center}.chat-widget-header.regular.transparent-style{background:hsla(0,0%,100%,.7);backdrop-filter:blur(10px)}.chat-widget-header.large{flex-wrap:wrap;background:var(--chat-widget-header-bg-large)}.chat-widget-header.large .back-to-chat svg path{stroke:var(--chat-widget-header-bg-large-actions-color)}.chat-widget-header.large .info-content-data{box-shadow:0px 5px 26px rgba(32,33,36,.25);border-radius:4px;background:var(--chat-widget-header-bg-large-info-bg);margin-top:26px;display:block;padding:16px 10px 16px 24px;overflow:inherit}.chat-widget-header.large .info-content-data .img-block{margin:-40px 0 8px 0}.chat-widget-header.large .info-content-data .img-block figure{width:48px;height:48px}.chat-widget-header.large .info-content-data .img-block figure img{width:48px;height:48px}.chat-widget-header.large .info-content-data .bot_icon{margin:-40px 0 8px 0px;width:48px;height:48px}.chat-widget-header.large .actions-info{position:absolute;right:16px;top:16px;z-index:1}.chat-widget-header.large .actions-info .btn-action svg path{fill:var(--chat-widget-header-bg-large-actions-color)}.chat-widget-header.large .actions-info .btn-action.btn-reconnect path{fill:none;stroke:var(--chat-widget-header-bg-large-actions-color)}.chat-widget-header.large .actions-info .btn-action.btn-reconnect[disabled]{opacity:.5}.chat-widget-head