  <meta name="viewport" content="width=device-width, user-scalable=no">
  <style nonce="">
    :root {
      --viewport-height: 100vh;
      --dynamic-viewport-height: 100vh;
      --hundred-percent-height: 100%;
      --banner-offset: 0px;
    }

    .landingPleaseWait {
      position: absolute;
      top: 0;
      font-size: 20px;
      z-index: 10;
      background: var(--global-white);
      display: flex;
      width: 100%;
      height: 100%;
      left: 0;
      right: 0;
      justify-content: center;
      align-items: center;
  }
  .kr-spinner-loader {
    border: 4px solid var(--backgroundColor2);
    border-radius: 50%;
    border-top: 4px solid var(--defaultwbcolor);
    width: 40px;
    height: 40px;
    -webkit-animation: kr-spin 2s linear infinite; /* Safari */
    animation: kr-spin 2s linear infinite;
  }

  /* Safari */
  @-webkit-keyframes kr-spin {
    0% { -webkit-transform: rotate(0deg); }
    100% { -webkit-transform: rotate(360deg); }
  }

  @keyframes kr-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @-webkit-keyframes lfadeOut {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes lfadeOut {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .loaderFadeOut {
    -webkit-animation-name: lfadeOut;
    animation-name: lfadeOut;
    animation-duration: 1s;
  }
  .dropdown-menu{
    display: none;
  }
  </style>
