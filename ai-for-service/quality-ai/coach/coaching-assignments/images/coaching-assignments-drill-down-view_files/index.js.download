(function() {
    const supportedLanguages = {
      en: 'en',
      ko: 'ko',
      ja: 'ja',
      de: 'de',
      zh: 'zh',
      es: 'es'
    };
    function isEmpty(obj) {
      return Object.keys(obj).length === 0;
    }
    function getAuthInfo() {
      let storageKey = 'jStorage';
      let storageType = clientAppConfig?.USE_SESSION_STORE ? 'sessionStorage' : 'localStorage';

      try {
        let _accountDetails = window[storageType].getItem(storageKey);
        if (_accountDetails) {
          _accountDetails = JSON.parse(_accountDetails);
        } else {
          return false;
        }
        // if (isEmpty(_accountDetails) && window.location.search.indexOf('currentBotId') !== -1) {
        //   window[storageType].setItem('currentBot', window.location.search.split('?currentBotId=')[1]);
        // }

        return _accountDetails;
      } catch (error) {
        return ;
      }
    }
    const setQueryParamLang=(lang)=>{
      window.sessionStorage.setItem('queryParamLang',lang)
    }
    const urlParams = new URLSearchParams(window.location.search);
    const integrationId = urlParams.get('integrationId');
    const integrationType = urlParams.get('integrationType');
    const integrationName = urlParams.get('integrationName');
    const templateId = urlParams.get('templateId');
    const templateName = urlParams.get('templateName');
    const eparams = urlParams.get('eparams');
    if(integrationId) sessionStorage.setItem('integrationId',integrationId);
    if(integrationType) sessionStorage.setItem('integrationType', integrationType);
    if(integrationName) sessionStorage.setItem('integrationName',integrationName);
    if(templateId) sessionStorage.setItem('templateId', templateId);
    if(templateName) sessionStorage.setItem('templateName',templateName);

    let langParam = urlParams.get('lang');
    let islangParamAvailable = false;
    // Store the lang param in localStorage or pass it to Angular via a global variable
    if (langParam) {
      langParam = langParam.replace(/^"|"$/g, '')
      if(['en','ko','ja','de','zh','es'].includes(langParam)){
        islangParamAvailable = true;
        setQueryParamLang(langParam);
      }
      // if(['reset'].includes(langParam)){
      //   window.sessionStorage.removeItem("queryParamLang"),
      //   setQueryParamLang('en')
      // }
    }
    // let queryParamLang=window.sessionStorage.getItem("queryParamLang");
    let queryParamLangAuthInfo = window.sessionStorage.getItem("queryParamLangAuth");
    let _accessToken = '';
    let authInfo = getAuthInfo();
    if(authInfo?.currentAccount && !islangParamAvailable && !queryParamLangAuthInfo){ 
      let userPrefLang = supportedLanguages[authInfo.currentAccount.userInfo?.personalInfo?.language] ?? 'en';
      setQueryParamLang(userPrefLang);
    }
    if(queryParamLangAuthInfo){
      window.sessionStorage.removeItem("queryParamLangAuth")
      setQueryParamLang(queryParamLangAuthInfo)
    }
    let authAppPath = '/auth';
    var retrunUrl =  '/?return_to='+window.location+'&product=builder' + (eparams ? ('&eparams=' + encodeURIComponent(eparams)) : '');
    if (authInfo) {
      try {
        if (authInfo.currentAccount) {
          _accessToken = authInfo.currentAccount.authorization.accessToken;  // For builder
        }
        else if (authInfo.entAdmin) {
          _accessToken = authInfo.entAdmin.authorization.accessToken;        // For Admin
        }
      } catch (error) {
        location.href = location.origin + authAppPath +retrunUrl;
        // return false;
      }
      if (!_accessToken) {

        location.href = location.origin + authAppPath +retrunUrl;
      }
    } else {
      location.href = location.origin + authAppPath +retrunUrl;
      // return false;
    }
})();