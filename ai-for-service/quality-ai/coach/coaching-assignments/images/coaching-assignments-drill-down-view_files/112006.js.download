(function(w, ns) {
  w[ns] = {};
  ['anonymous', 'call', 'clearShow', 'content', 'debug', 'group', 'identify', 'initAmplitude', 'initBraze', 'initCalq', 'initCIO', 'initFullStory', 'initGA', 'initGTM', 'initHeap', 'initHotjar', 'initIntercom', 'initKlaviyo', 'initKM', 'initLl', 'initLogRocket', 'initMixpanel', 'initRudderstack', 'initSegment', 'initTD', 'initWoopra', 'loadLaunchpad', 'off', 'on', 'once', 'page', 'reset', 'settings', 'show', 'start', 'track', 'user'].forEach(function(m) {
    w[ns][m] = function() { console && console.warn('Your Appcues account has expired, but you have not uninstalled Appcues. Please contact us at support@appcues.com.') }
  })
})(window, 'Appcues')