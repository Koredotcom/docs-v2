AGENT: Sub_s_goto
GOAL: "Collect a name."

FLOW:
  entry_point: collect
  steps:
    - collect
    - done

  collect:
    REASONING: false
    GATHER:
      - full_name: required
        prompt: "What is your name?"
    SUB_INTENTS:
      - INTENT: "skip ahead"
        GOTO: done
    THEN: done

  done:
    REASONING: false
    RESPOND: "Thanks {{full_name}}."
    THEN: COMPLETE
