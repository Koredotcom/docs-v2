AGENT: Sub_s_name_form
GOAL: "Collect a name."

FLOW:
  entry_point: collect
  steps:
    - collect
    - done

  collect:
    REASONING: false
    GATHER:
      - full_name: required
        prompt: "What is your name?"
    SUB_INTENTS:
      - NAME: "rename"
        RESPOND: "Sure."
      - "spelling help"
        RESPOND: "Spell it."
    THEN: done

  done:
    REASONING: false
    RESPOND: "Thanks {{full_name}}."
    THEN: COMPLETE
